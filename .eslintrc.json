{
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-throw-literal": "error",
    "no-return-await": "warn",
    "require-await": "warn",
    "no-promise-executor-return": "error"
  },
  "ignorePatterns": ["node_modules/", "data/", "*.json"]
}
