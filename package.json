{
  "name": "kizuna-news-provider",
  "version": "5.1.0",
  "description": "Private, server-to-server news discovery provider for Kizuna",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "node --check server.js && node --check src/app.js",
    "start": "node server.js",
    "test": "node --require ./test/network-guard.js --test test/*.test.js",
    "test:live": "node scripts/live-smoke.js",
    "lint": "eslint . --ignore-pattern 'node_modules/' --ignore-pattern 'data/'",
    "lint:fix": "eslint . --fix --ignore-pattern 'node_modules/' --ignore-pattern 'data/'"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "express": "^5.1.0",
    "he": "^1.2.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.x"
  },
  "keywords": [
    "anime",
    "news",
    "api",
    "scraping",
    "manga"
  ],
  "author": "Shinei Nouzen",
  "license": "MIT"
}
